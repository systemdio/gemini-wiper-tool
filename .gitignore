# Gemini Cleaner — .gitignore

# ─── Node.js ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnp/
.pnp.js

# ─── Build output ───────────────────────────────────────────────────────────
dist/
*.zip
*.xpi
*.crx

# ─── Generated PNG icons (generated from icons/icon.svg via npm run icons) ──
icons/*.png
icons/*_gray.png

# ─── web-ext artifacts ──────────────────────────────────────────────────────
web-ext-artifacts/

# ─── OS / Editor ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# ─── Environment / secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
